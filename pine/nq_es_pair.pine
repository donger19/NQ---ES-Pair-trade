//@version=6
indicator("NQ-ES Pair: Trend & Gap v4", shorttitle="NQ-ES Pair v4", overlay=false, max_bars_back=1000)

// ── Inputs ──────────────────────────────────────────────────────────────
sym1     = input.symbol("CME_MINI:NQ1!", "Asset 1 (NQ)")
sym2     = input.symbol("CME_MINI:ES1!", "Asset 2 (ES)")
// NOTE: input variable names deliberately match the keys in config.json /
// SignalEngine.defaults() one-for-one. Do not rename one side only.
normLen  = input.int(240, "Normalization lookback (bars)", minval=10)
zWindow  = input.int(60,  "Residual z-score window",       minval=10)
delta    = input.float(1e-8, "Kalman delta (state noise)", step=1e-9)
rLambda  = input.float(0.99, "R forgetting factor",        step=0.005)
esRefPrice = input.float(7550.0, "ES centering anchor", step=50.0, tooltip="Only affects conditioning of the log-log regression - alpha absorbs any anchor error. Bump it if ES drifts more than ~5% away. MUST match esRefPrice in config.json.")
showZ    = input.bool(true,  "Show Kalman residual z-score")
showTbl  = input.bool(true,  "Show readout table")
showTrnd = input.bool(true,  "Show projected trend lines")
trendLen = input.int(100, "Trend regression lookback (bars)", minval=10)
projBars = input.int(20,  "Projection distance (bars)",       minval=1)
showFair = input.bool(true,  "Show fair-value line on price chart (alpha + beta*ES)")
showSig  = input.bool(true,  "Show entry/exit markers")

G_RGM = "Regime filter"
showRgm      = input.bool(true,  "Shade volatile regime",  group=G_RGM)
volThreshold = input.float(1.5, "Volatile vol-ratio threshold", step=0.1, group=G_RGM)
regimeWindow = input.int(400, "Robust-sigma median window (bars)", minval=20, group=G_RGM)
calmOnly     = input.bool(false, "Fade entries only in calm regime (off: rule-2 momentum veto governs)", group=G_RGM)
// Frozen HMM parameters, fitted offline by MATLAB. Regenerate with
// computeFeatures + RegimeDetector.paramsHMM and paste from config.json
// (regimeParams). Pine cannot run EM, but it can filter with these.
hmmP11     = input.float(0.98557, "HMM P(calm->calm)",     step=0.0001, group=G_RGM)
hmmP22     = input.float(0.91411, "HMM P(vol->vol)",       step=0.0001, group=G_RGM)
hmmMuCalm  = input.float(-0.0251, "HMM mu calm (NQ pts)",  step=0.001,  group=G_RGM)
hmmSdCalm  = input.float(3.966,   "HMM sigma calm (NQ pts)", step=0.001, group=G_RGM)
hmmMuVol   = input.float(-0.8709, "HMM mu volatile (NQ pts)", step=0.001, group=G_RGM)
hmmSdVol   = input.float(14.445,  "HMM sigma volatile (NQ pts)", step=0.001, group=G_RGM)

// Rules 1-2: entry gate, spike confirmation, momentum veto
G_ENTRY = "Entry rules (1-2)"
entryZ      = input.float(2.0, "Entry gate |z| (no entries below this)", step=0.05, group=G_ENTRY)
confirmBars = input.int(1, "Confirmation bars after breach (1 bar @ 1-min chart ~ 30-60s)", minval=1, group=G_ENTRY, tooltip="Minimum 1: the state machine never enters on the breach bar, so 0 and 1 were provably identical.")
velBars     = input.int(3, "Momentum lookback (bars)", minval=1, group=G_ENTRY)
zVelMax     = input.float(1.0, "Max |z velocity| to allow fade", step=0.05, group=G_ENTRY)
rocMax      = input.float(0.15, "Max |NQ ROC %| to allow fade", step=0.01, group=G_ENTRY)
zHardStop   = input.float(4.0, "Hard-stop |z| (spread breaking, no fades armed beyond)", step=0.25, group=G_ENTRY)

// Rule 3: chop / weak-signal filter
G_CHOP = "Chop filter (3)"
chopBand      = input.float(1.5, "Chop band |z|", step=0.05, group=G_CHOP)
chopReversals = input.int(3, "Zero-crossings to call chop", minval=1, group=G_CHOP)
chopWindow    = input.int(10, "Chop lookback (bars)", minval=2, group=G_CHOP)

// Rule 4: risk & profit framework
G_RISK = "Risk & exits (4)"
maxRiskUSD = input.float(500.0, "Max risk per trade ($)", step=50, group=G_RISK)
stopZ     = input.float(2.0, "Stop distance (z-units adverse from entry)", step=0.25, group=G_RISK)
tpMode    = input.string("2R", "Take-profit mode", options=["2R", "1R"], group=G_RISK, tooltip="2R = runner, 1R = quick. Values match cfg.signal.tpMode exactly.")
zExit     = input.float(0.0, "Z exit level (mean reached)", step=0.25, group=G_RISK)
consolBand = input.float(1.0, "Consolidation exit band |z|", step=0.05, group=G_RISK)
consolBars = input.int(4, "Consecutive bars inside band to exit", minval=1, group=G_RISK)
ptValueNQ  = input.float(20.0, "NQ $ per point",  group=G_RISK)
ptValueES  = input.float(50.0, "ES $ per point",  group=G_RISK)
ptValueMNQ = input.float(2.0,  "MNQ $ per point", group=G_RISK)
ptValueMES = input.float(5.0,  "MES $ per point", group=G_RISK)

// Rules 5-6: convergence arm / trend cross / intertwine
G_CONV = "Convergence (5-6)"
armDist        = input.float(0.15, "Arm distance |NQ-ES trend gap| (%)", step=0.01, group=G_CONV)
convBars       = input.int(5, "Gap must be shrinking vs N bars ago", minval=1, group=G_CONV)
intertwineBand = input.float(0.05, "Intertwine band |gap| (%)", step=0.01, group=G_CONV)
intertwineBars = input.int(4, "Bars inside band = intertwined", minval=1, group=G_CONV)

// Rule 8: manual ICT gap bias
G_GAP = "ICT gap bias - manual (8)"
gapDir    = input.string("none", "Nearest unmitigated gap direction", options=["none", "up", "down"], group=G_GAP)
gapLevel  = input.price(0.0, "Gap level (NQ price, 0 = hide)", group=G_GAP)
gapPolicy = input.string("block", "Counter-gap entry policy", options=["block", "half", "off"], group=G_GAP)

G_ALERT = "Alerts"

G_VD = "Volume delta"
showVD   = input.bool(true,  "Show per-leg volume delta (σ)", group=G_VD)
vdTf     = input.timeframe("1", "Lower timeframe for delta",  group=G_VD)
vdLen    = input.int(60, "Delta normalization window", minval=10, group=G_VD)

// ── Data ────────────────────────────────────────────────────────────────
nq = request.security(sym1, timeframe.period, close)
es = request.security(sym2, timeframe.period, close)

// ── Normalized trend lines (% change vs `normLen` bars ago) ─────────────
normNQ = 100 * (nq / nq[normLen] - 1)
normES = 100 * (es / es[normLen] - 1)
gap    = normNQ - normES

// ── Kalman filter (mirrors src/KalmanHedge.m) ───────────────────────────
//   log(NQ_t) = alpha_t + beta_t * (log(ES_t) - log(esRef)) + e_t
//
// WHY LOG-LOG AND CENTERED. The old price-space form NQ = alpha + beta*ES
// is unidentified on index data: cond([1 ES]) ~ 4e5, so alpha and beta are
// collinear and the filter never leaves wherever it was seeded. This script
// and the MATLAB backtest disagreed on beta by 3.81 vs 6.02 after 41,000
// bars - differing on 4% of |z|>=2 entries, permanently, because a chart's
// starting bar depends on how far you have scrolled. Centering the log
// regressor drops cond to ~58, which makes the model identified: opposite
// seeds converge (beta 1.6443 vs 1.6448, z corr 0.9998). That is what makes
// this script and SignalEngine.m the same model.
//
// Everything downstream stays in NQ POINTS: e is the innovation in points
// and betaPx = betaLog * predNQ / es is the price-space hedge ratio.
var float aLog = na   // log-space intercept
var float bLog = na   // log-space slope (NQ's return elasticity to ES)
var float p00  = 0.01
var float p01  = 0.0
var float p10  = 0.0
var float p11  = 0.01
var float R    = 1e-6

// naive seed, identical to KalmanHedge.seed - simple enough to reproduce
// exactly on both sides, which an OLS warm start over a scroll-dependent
// window is not
if na(aLog) and not na(nq) and not na(es)
    aLog := math.log(nq)
    bLog := 1.0

xES = math.log(es) - math.log(esRefPrice)

// prediction with the *prior* state (predictOnly behaviour on the forming bar)
float yhat   = aLog + bLog * xES
float eLog   = math.log(nq) - yhat
float predNQ = math.exp(yhat)
float e      = nq - predNQ            // innovation in NQ points

// commit the state update only on closed bars, like the MATLAB model
if barstate.isconfirmed and not na(eLog)
    q    = delta / (1 - delta)
    pp00 = p00 + q
    pp01 = p01
    pp10 = p10
    pp11 = p11 + q
    S    = pp00 + xES * (pp01 + pp10) + xES * xES * pp11 + R
    k0   = (pp00 + xES * pp01) / S
    k1   = (pp10 + xES * pp11) / S
    aLog := aLog + k0 * eLog
    bLog := bLog + k1 * eLog
    p00 := (1 - k0) * pp00 - k0 * xES * pp10
    p01 := (1 - k0) * pp01 - k0 * xES * pp11
    p10 := -k1 * pp00 + (1 - k1 * xES) * pp10
    p11 := -k1 * pp01 + (1 - k1 * xES) * pp11
    R   := rLambda * R + (1 - rLambda) * eLog * eLog

// price-space view: slope of the fitted curve here, and the intercept that
// reproduces the fitted level, so the fair-value line and the ES hedge leg
// stay in price terms exactly as SignalEngine sees them
b = bLog * predNQ / es
a = predNQ - b * es

// residual z-score over a rolling window (zWindow in the MATLAB model).
// ta.stdev is a POPULATION std; MATLAB's std() is the sample version, so
// rescale or z, stopPts and position size all sit ~0.84% off the backtest.
resMu  = ta.sma(e, zWindow)
resSd  = ta.stdev(e, zWindow) * math.sqrt(zWindow / (zWindow - 1.0))
// an under-filled window is not comparable to the steady-state estimate;
// KalmanHedge returns NaN for the same reason, so nothing is sized off it
resSdOk = bar_index >= zWindow and not na(resSd) and resSd > 0
zScore = resSdOk ? (e - resMu) / resSd : na

// ── Regime: two models, and the rules gate on their AGREEMENT ───────────
// (1) EWMA vol-ratio, and (2) a 2-state Gaussian HMM run as a causal
// forward filter with parameters fitted offline in MATLAB (Pine cannot run
// EM, but it can filter with frozen parameters). Both are causal, so
// neither can look ahead. Mirrors RegimeDetector.filterEwma / filterHMM.
var float ewmaVar = na
if barstate.isconfirmed and not na(e)
    ewmaVar := na(ewmaVar) ? e * e : 0.94 * ewmaVar + 0.06 * e * e
medianVol = ta.median(math.abs(nz(e)), regimeWindow) * 1.4826   // robust sigma
volRatio  = math.sqrt(nz(ewmaVar)) / math.max(medianVol, 1e-10)
pVolEwma  = 1 / (1 + math.exp(-4 * (volRatio - volThreshold)))

// HMM forward filter: a_i <- sum_j a_j * P_ji * N(e; mu_i, sd_i), normalised
var float aCalm = na
var float aVol  = na
if na(aCalm)
    hmmDen = 2.0 - hmmP11 - hmmP22
    aCalm := hmmDen > 0 ? (1 - hmmP22) / hmmDen : 0.5   // stationary prior
    aVol  := hmmDen > 0 ? (1 - hmmP11) / hmmDen : 0.5
if barstate.isconfirmed and not na(e)
    prC = aCalm * hmmP11 + aVol * (1 - hmmP22)
    prV = aCalm * (1 - hmmP11) + aVol * hmmP22
    // shared 1/sqrt(2*pi) cancels in the normalisation
    lC  = math.exp(-0.5 * math.pow((e - hmmMuCalm) / hmmSdCalm, 2)) / hmmSdCalm
    lV  = math.exp(-0.5 * math.pow((e - hmmMuVol) / hmmSdVol, 2)) / hmmSdVol
    wC  = prC * lC
    wV  = prV * lV
    sw  = wC + wV
    aCalm := sw > 0 ? wC / sw : prC
    aVol  := sw > 0 ? wV / sw : prV
pVolHMM = nz(aVol, 0.5)

pVol   = pVolHMM            // headline reading shown on the chart
isCalm = (pVolHMM >= 0.5) == (pVolEwma >= 0.5) and pVolHMM < 0.5
bgcolor(showRgm and not isCalm ? color.new(color.red, 88) : na, title="Volatile regime")

// ── Per-leg volume delta from lower-timeframe bars ──────────────────────
nqDeltaArr = request.security_lower_tf(sym1, vdTf, close > open ? volume : close < open ? -volume : 0.0)
esDeltaArr = request.security_lower_tf(sym2, vdTf, close > open ? volume : close < open ? -volume : 0.0)
nqDelta  = array.sum(nqDeltaArr)
esDelta  = array.sum(esDeltaArr)
nqDeltaZ = nqDelta / ta.stdev(nqDelta, vdLen)   // in sigmas, comparable to z
esDeltaZ = esDelta / ta.stdev(esDelta, vdLen)

// ── Rule inputs computed every bar ──────────────────────────────────────
// momentum (rule 2): z velocity and underlying NQ rate-of-change
zVel  = zScore - zScore[velBars]
nqRoc = 100 * (nq / nq[velBars] - 1)
momentumSettled = math.abs(zVel) <= zVelMax and math.abs(nqRoc) <= rocMax

// chop (rule 3): >= chopReversals zero-crossings inside +/-chopBand over chopWindow
zeroCross  = not na(zScore) and not na(zScore[1]) and ((zScore > 0 and zScore[1] <= 0) or (zScore < 0 and zScore[1] >= 0))
crossCount = math.sum(zeroCross ? 1 : 0, chopWindow)
maxAbsZ    = ta.highest(math.abs(zScore), chopWindow)
isChop     = crossCount >= chopReversals and maxAbsZ < chopBand

// convergence / intertwine (rules 5-6) on the normalized trend gap
gapAbs      = math.abs(gap)
converging  = gapAbs < armDist and gapAbs < math.abs(gap[convBars])
intertwined = ta.highest(gapAbs, intertwineBars) < intertwineBand
crossUp     = ta.crossover(normNQ, normES)
crossDn     = ta.crossunder(normNQ, normES)

// directional context (rule 5/6): ES trend slope, gated by regime definition
esFitBar   = ta.linreg(normES, trendLen, 0)
esSlopeBar = esFitBar - ta.linreg(normES, trendLen, 1)
// both models must be decisive AND agree; mirrors SignalEngine.step
defHMM  = pVolHMM  < 0.40 or pVolHMM  > 0.60
defEwma = pVolEwma < 0.40 or pVolEwma > 0.60
regimeAgree   = (pVolHMM >= 0.5) == (pVolEwma >= 0.5)
regimeDefined = defHMM and defEwma and regimeAgree
contextDir = not regimeDefined ? 0 : esSlopeBar < 0 ? -1 : esSlopeBar > 0 ? 1 : 0
// contextDir -1 = bearish -> short NQ / long ES on cross; +1 = bullish mirror

alertOk = not calmOnly or isCalm

// ── Signal state machine (replaces the v2 pos variable) ────────────────
// 0 FLAT -> 1 CONVERGENCE_ARMED -> 2 SIGNAL_PENDING -> 3 IN_POSITION
//        -> 4 TP_ZONE -> 0;  3 -> 5 REVERSAL_ELIGIBLE -> 0
// Direct z-spike fades enter at SIGNAL_PENDING (no convergence prerequisite).
var int   state        = 0
var int   dir          = 0    // +1 long NQ / short ES, -1 short NQ / long ES
var int   pendType     = 0    // 1 = z-fade breach, 2 = trend-cross trigger
var int   confirmCount = 0
var int   consolCount  = 0
var float entryZv      = na
var float entryPx      = na
var float entryEs      = na
var float entryBeta    = na
var float entryStopPts = na
var float entrySd      = na
var bool  entryFade    = false   // true = z-fade entry through the rule-1 gate
var float entrySizeMult = 1.0    // 0.5 when gapPolicy="half" halves a counter-gap entry
// fair value frozen at the breach/trigger bar: closed-bar innovations are
// near-white (the filter absorbs each spike on the next update), so
// confirmation must ask "is PRICE still stretched vs the fair value at
// spike time?" - the same stretch the live forming-bar z displays
var float frozenA      = na
var float frozenB      = na
var float frozenSd     = na
var float stopLinePx   = na
var float tgtLinePx    = na

// ── Position sizing (rule 4) ────────────────────────────────────────────
// Residual accrues in NQ points on the NQ leg; the beta-scaled ES leg
// hedges the common move, so risk per 1 NQ pair-lot ~ stopPts * $/pt(NQ).
stopPts   = stopZ * resSd
sizeMult  = state >= 3 ? entrySizeMult : 1.0
nNQ       = stopPts > 0 ? math.floor(maxRiskUSD * sizeMult / (stopPts * ptValueNQ)) : 0
nMNQ      = stopPts > 0 ? math.floor(maxRiskUSD * sizeMult / (stopPts * ptValueMNQ)) : 0
useMicros = nNQ < 1
// while in a position the displayed hedge must be the one the trade was
// sized with, not the live slope, or the table drifts under an open trade
betaSize  = state >= 3 and not na(entryBeta) ? entryBeta : b
nES       = math.max(1, math.round(nNQ * betaSize * ptValueNQ / ptValueES))
nMES      = math.max(1, math.round(nMNQ * betaSize * ptValueMNQ / ptValueMES))
riskUsed  = useMicros ? nMNQ * stopPts * ptValueMNQ : nNQ * stopPts * ptValueNQ
tpR       = tpMode == "2R" ? 2.0 : 1.0

// ── Why-no-entry diagnostics ────────────────────────────────────────────
// Every gate that can suppress a setup, computed once and consumed three
// ways: the readout table, the alert payload, and the parity export column.
// Mirrors SignalEngine's out.gates so the two can be diffed bar for bar.
gWarmup   = not resSdOk
gInPos    = state >= 3
gZInside  = not na(zScore) and math.abs(zScore) < entryZ
gBeyondHS = not na(zScore) and math.abs(zScore) >= zHardStop
gChop     = isChop
gZVel     = not na(zVel) and math.abs(zVel) > zVelMax
gRoc      = not na(nqRoc) and math.abs(nqRoc) > rocMax
gRegime   = not regimeDefined
gCalmVeto = calmOnly and not isCalm
gAligned  = gapDir == "none" or (dir == 1 and gapDir == "up") or (dir == -1 and gapDir == "down")
gGapBlock = not gAligned and gapPolicy == "block"
gConfirm  = state == 2 and confirmCount < confirmBars
gNoConv   = not (converging or intertwined)

gateMask = (gZInside ? 1 : 0) + (gBeyondHS ? 2 : 0) + (gChop ? 4 : 0) + (gZVel ? 8 : 0) + (gRoc ? 16 : 0) + (gRegime ? 32 : 0) + (gCalmVeto ? 64 : 0) + (gGapBlock ? 128 : 0) + (gConfirm ? 256 : 0) + (gWarmup ? 512 : 0) + (gNoConv ? 1024 : 0) + (gInPos ? 2048 : 0)

// first blocker in a fixed priority order: one actionable sentence
blockReason = gWarmup ? "warming up (resSd)" : gInPos ? "in position" : gBeyondHS ? "beyond hard stop |z|>=" + str.tostring(zHardStop, "#.#") : gChop ? "chop filter active" : gConfirm ? "confirming " + str.tostring(confirmCount) + "/" + str.tostring(confirmBars) : gZInside ? "z inside gate (|z|<" + str.tostring(entryZ, "#.##") + ")" : gZVel ? "z velocity too fast" : gRoc ? "NQ ROC too fast" : gGapBlock ? "counter-gap blocked" : gCalmVeto ? "calmOnly veto" : gRegime ? "regime undefined/disagree" : gNoConv ? "no convergence" : "ready"


bool sigArm        = false
bool sigPending    = false
bool sigEnterLong  = false
bool sigEnterShort = false
bool sigExit       = false
bool sigStop       = false
bool sigReversal   = false
bool sigGapBlocked = false
float rExit        = na

// live R multiple while in a position: pair P&L in price terms
// (NQ leg minus beta-scaled ES leg, in NQ points, over the stop distance)
rNow = (state == 3 or state == 5) and not na(entryPx) ?
     dir * ((nq - entryPx) - entryBeta * (es - entryEs)) / entryStopPts : na

if barstate.isconfirmed and not na(zScore) and not na(resSd) and resSd > 0
    // fade candidate from the entry gate (rule 1); no fades beyond zHardStop (rule 2)
    breachDir = math.abs(zScore) >= zHardStop ? 0 : zScore >= entryZ ? -1 : zScore <= -entryZ ? 1 : 0

    if state == 0   // FLAT
        if breachDir != 0 and alertOk and not isChop
            state := 2
            dir := breachDir
            pendType := 1
            confirmCount := 0
            frozenA := nq - zScore * resSd - b * es
            frozenB := b
            frozenSd := resSd
            sigPending := true
        else if contextDir != 0 and not isChop and (converging or intertwined)
            state := 1
            dir := contextDir
            sigArm := true

    else if state == 1   // CONVERGENCE_ARMED
        if isChop or contextDir == 0 or contextDir != dir
            state := 0
            dir := 0
        else if breachDir != 0 and alertOk
            state := 2
            dir := breachDir
            pendType := 1
            confirmCount := 0
            frozenA := nq - zScore * resSd - b * es
            frozenB := b
            frozenSd := resSd
            sigPending := true
        else if dir == -1 ? crossUp : crossDn
            // directional trigger only: bearish = NQ crossing UP into ES
            // ("NQ trades up to ES; once they cross, NQ sells off hard")
            state := 2
            pendType := 2
            confirmCount := 0
            frozenA := nq - zScore * resSd - b * es
            frozenB := b
            frozenSd := resSd
            sigPending := true
        else if not (converging or intertwined)
            state := 0
            dir := 0

    else if state == 2   // SIGNAL_PENDING (confirming, rule 2)
        confirmCount := confirmCount + 1
        zHold = (nq - (frozenA + frozenB * es)) / frozenSd
        stillValid = pendType == 1 ?
             (dir == -1 ? zHold >= entryZ and zHold < zHardStop : zHold <= -entryZ and zHold > -zHardStop) :
             contextDir == dir
        if isChop or not stillValid
            state := 0
            dir := 0
            pendType := 0
        else if confirmCount >= confirmBars and momentumSettled
            aligned = gapDir == "none" or (dir == 1 and gapDir == "up") or (dir == -1 and gapDir == "down")
            if not aligned and gapPolicy == "block"
                sigGapBlocked := true
                state := 0
                dir := 0
                pendType := 0
            else
                state := 3
                entryZv := zHold
                entryPx := nq
                entryEs := es
                entryBeta := frozenB
                entryStopPts := stopZ * resSd
                entrySd := frozenSd
                entryFade := pendType == 1
                entrySizeMult := not aligned and gapPolicy == "half" ? 0.5 : 1.0
                consolCount := 0
                sigEnterLong := dir == 1
                sigEnterShort := dir == -1

    else if state == 3   // IN_POSITION
        // pair P&L in price terms: NQ leg minus beta-scaled ES leg (NQ pts)
        resDelta = (nq - entryPx) - entryBeta * (es - entryEs)
        rBar = dir * resDelta / entryStopPts
        advCross = dir == 1 ? crossDn : crossUp
        // Stop/target are levels in NQ that MOVE WITH ES, because the exit
        // test below is on the beta-adjusted pair, not on NQ alone. Fixing
        // them at entry (as v3 did) drew lines that never coincided with the
        // rule. Recomputed every bar, these are the NQ prices at which rBar
        // crosses -1R and +tpR given the current ES - i.e. where to rest an
        // order right now.
        hedged = entryPx + entryBeta * (es - entryEs)
        stopLinePx := hedged - dir * entryStopPts
        tgtLinePx  := hedged + dir * tpR * entryStopPts
        // z-reversion TP only for fade entries, measured vs the frozen
        // entry fair value ("price actually reverted"), not the
        // self-resetting rolling innovation z
        zHoldNow = entryZv + resDelta / entrySd
        zReverted = entryFade and (dir == -1 ? zHoldNow <= zExit : zHoldNow >= -zExit)
        consolCount := math.abs(zScore) < consolBand ? consolCount + 1 : 0
        if rBar <= -1.0 or math.abs(zScore) >= zHardStop
            state := 0
            sigStop := true
            rExit := rBar
            dir := 0
        else if advCross
            state := 5
            sigReversal := true
        else if rBar >= tpR or zReverted
            state := 4
            sigExit := true
            rExit := rBar
        else if consolCount >= consolBars or isChop
            state := 0
            sigExit := true
            rExit := rBar
            dir := 0

    else if state == 4   // TP_ZONE (target hit last bar; go flat)
        state := 0
        dir := 0

    else if state == 5   // REVERSAL_ELIGIBLE (adverse trend cross)
        rBar = dir * ((nq - entryPx) - entryBeta * (es - entryEs)) / entryStopPts
        sigExit := true
        rExit := rBar
        state := 0
        dir := 0

    if state == 0
        stopLinePx := na
        tgtLinePx := na
        entrySizeMult := 1.0
        entryZv := na
        entryPx := na
        entryEs := na
        entryBeta := na
        entryStopPts := na
        entrySd := na

// R-multiple label on every close (rule 4 logging; authoritative log = MATLAB backtest)
if showSig and not na(rExit)
    label.new(bar_index, zScore, "R = " + str.tostring(rExit, "#.##"),
         color=color.new(rExit >= 0 ? color.green : color.red, 70),
         textcolor=rExit >= 0 ? color.green : color.red,
         style=label.style_label_up, size=size.small)

// flip guidance while reversal-eligible: does the manual gap agree with the new direction?
revDir  = dir == 1 ? -1 : 1
canFlip = state == 5 and gapDir != "none" and ((revDir == 1 and gapDir == "up") or (revDir == -1 and gapDir == "down"))

// ── State visuals ───────────────────────────────────────────────────────
color stCol = state == 1 ? color.new(color.yellow, 85) :
     state == 2 ? color.new(color.orange, 82) :
     state == 3 ? color.new(color.green, 86) :
     state == 4 ? color.new(color.aqua, 82) :
     state == 5 ? color.new(color.fuchsia, 82) : na
bgcolor(stCol, title="Signal state")

// ── Plots ───────────────────────────────────────────────────────────────
plot(normNQ, "NQ trend", color=color.new(color.teal,   0), linewidth=2)
plot(normES, "ES trend", color=color.new(color.orange, 0), linewidth=2)
plot(gap, "Gap (NQ - ES, %)", style=plot.style_columns,
     color=gap >= 0 ? color.new(color.teal, 70) : color.new(color.orange, 70))

plot(showZ ? zScore : na, "Kalman residual z", color=color.new(color.purple, 0))

// Kalman mean line: fair NQ = alpha + beta*ES, drawn on the main price chart.
plot(showFair ? yhat : na, "Fair NQ (alpha + beta*ES)",
     color=color.new(color.aqua, 0), linewidth=2, force_overlay=true)

// the z entry bands translated into price, flanking the mean line
upperPx = yhat + resMu + entryZ * resSd
lowerPx = yhat + resMu - entryZ * resSd
plot(showFair ? upperPx : na, "NQ rich band (+z)",
     color=color.new(color.red,   35), linewidth=1, force_overlay=true)
plot(showFair ? lowerPx : na, "NQ cheap band (-z)",
     color=color.new(color.green, 35), linewidth=1, force_overlay=true)

// live stop / target and manual gap level on the price chart
plot(stopLinePx, "Stop (price est)", color=color.new(color.maroon, 20),
     style=plot.style_linebr, force_overlay=true)
plot(tgtLinePx, "Target (price est)", color=color.new(color.green, 20),
     style=plot.style_linebr, force_overlay=true)
plot(gapDir != "none" and gapLevel > 0 ? gapLevel : na, "Manual gap level",
     color=color.new(color.blue, 30), style=plot.style_linebr, force_overlay=true)

// entry/exit markers on the price chart
plotshape(showSig and sigEnterLong, "Enter: long NQ / short ES",
     style=shape.triangleup, location=location.belowbar, size=size.small,
     color=color.new(color.green, 0), text="LONG NQ\nSHORT ES",
     textcolor=color.new(color.green, 0), force_overlay=true)
plotshape(showSig and sigEnterShort, "Enter: short NQ / long ES",
     style=shape.triangledown, location=location.abovebar, size=size.small,
     color=color.new(color.red, 0), text="SHORT NQ\nLONG ES",
     textcolor=color.new(color.red, 0), force_overlay=true)
plotshape(showSig and sigExit, "Exit pair trade",
     style=shape.xcross, location=location.abovebar, size=size.small,
     color=color.new(color.gray, 0), text="EXIT",
     textcolor=color.new(color.gray, 0), force_overlay=true)
plotshape(showSig and sigStop, "Hard stop (spread breaking)",
     style=shape.xcross, location=location.abovebar, size=size.small,
     color=color.new(color.maroon, 0), text="STOP",
     textcolor=color.new(color.maroon, 0), force_overlay=true)
plotshape(showSig and sigArm, "Convergence armed",
     style=shape.circle, location=location.abovebar, size=size.tiny,
     color=color.new(color.yellow, 0), force_overlay=true)
plotshape(showSig and sigReversal, "Reversal eligible",
     style=shape.diamond, location=location.abovebar, size=size.small,
     color=color.new(color.fuchsia, 0), text="REV?",
     textcolor=color.new(color.fuchsia, 0), force_overlay=true)

plot(showVD ? nqDeltaZ : na, "NQ volume delta (σ)", style=plot.style_histogram,
     color=color.new(color.teal, 45), linewidth=2)
plot(showVD ? esDeltaZ : na, "ES volume delta (σ)", style=plot.style_histogram,
     color=color.new(color.orange, 45), linewidth=2)
hline(0, "Zero", color=color.new(color.gray, 50))
hline(entryZ,  "Z entry gate +", color=color.new(color.red,   60), linestyle=hline.style_dotted)
hline(-entryZ, "Z entry gate -", color=color.new(color.green, 60), linestyle=hline.style_dotted)
hline(chopBand,  "Chop band +", color=color.new(color.gray, 75), linestyle=hline.style_dashed)
hline(-chopBand, "Chop band -", color=color.new(color.gray, 75), linestyle=hline.style_dashed)
// the "nothing arms beyond +/-zHardStop" rule was previously invisible
hline(zHardStop,  "Hard stop +", color=color.new(color.red, 35), linestyle=hline.style_dotted)
hline(-zHardStop, "Hard stop -", color=color.new(color.red, 35), linestyle=hline.style_dotted)

// ── Projected trend lines (linear regression, extended right) ──────────
var line  nqTrend = na
var line  esTrend = na
var line  gapTrend = na
var label nqLbl = na
var label esLbl = na

if showTrnd and barstate.islast
    nqFit    = ta.linreg(normNQ, trendLen, 0)
    nqSlope  = nqFit - ta.linreg(normNQ, trendLen, 1)
    esFit    = ta.linreg(normES, trendLen, 0)
    esSlope  = esFit - ta.linreg(normES, trendLen, 1)
    gapFit   = ta.linreg(gap, trendLen, 0)
    gapSlope = gapFit - ta.linreg(gap, trendLen, 1)

    line.delete(nqTrend), line.delete(esTrend), line.delete(gapTrend)
    label.delete(nqLbl),  label.delete(esLbl)

    nqTrend := line.new(bar_index - trendLen + 1, nqFit - nqSlope * (trendLen - 1),
         bar_index, nqFit, extend=extend.right,
         color=color.new(color.teal, 30), style=line.style_dashed, width=1)
    esTrend := line.new(bar_index - trendLen + 1, esFit - esSlope * (trendLen - 1),
         bar_index, esFit, extend=extend.right,
         color=color.new(color.orange, 30), style=line.style_dashed, width=1)
    gapTrend := line.new(bar_index - trendLen + 1, gapFit - gapSlope * (trendLen - 1),
         bar_index, gapFit, extend=extend.right,
         color=color.new(color.gray, 40), style=line.style_dotted, width=1)

    nqProj = nqFit + nqSlope * projBars
    esProj = esFit + esSlope * projBars
    nqLbl := label.new(bar_index + projBars, nqProj,
         "NQ → " + str.tostring(nqProj, "#.##") + "%",
         color=color.new(color.teal, 80), textcolor=color.teal,
         style=label.style_label_left, size=size.small)
    esLbl := label.new(bar_index + projBars, esProj,
         "ES → " + str.tostring(esProj, "#.##") + "%",
         color=color.new(color.orange, 80), textcolor=color.orange,
         style=label.style_label_left, size=size.small)

// ── Readout table ───────────────────────────────────────────────────────
var table tbl = table.new(position.top_right, 2, 16, border_width=1,
     bgcolor=color.new(color.black, 20), frame_color=color.new(color.gray, 50))
if showTbl and barstate.islast
    txtCol = color.white
    stateName = state == 0 ? "FLAT" :
         state == 1 ? "CONV ARMED" :
         state == 2 ? "PENDING " + str.tostring(confirmCount) + "/" + str.tostring(confirmBars) :
         state == 3 ? "IN POSITION" :
         state == 4 ? "TP ZONE" : "REVERSAL?"
    dirName = dir == 1 ? "LONG NQ / SHORT ES" : dir == -1 ? "SHORT NQ / LONG ES" : "-"
    sizeTxt = useMicros ?
         str.tostring(nMNQ) + " MNQ / " + str.tostring(nMES) + " MES" :
         str.tostring(nNQ) + " NQ / " + str.tostring(nES) + " ES"
    table.cell(tbl, 0, 0, "beta",  text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 0, str.tostring(b, "#.####"), text_color=color.new(color.teal, 0))
    table.cell(tbl, 0, 1, "alpha", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 1, str.tostring(a, "#.##"),   text_color=color.new(color.orange, 0))
    table.cell(tbl, 0, 2, "z",     text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 2, str.tostring(zScore, "#.##") + (isChop ? "  CHOP" : momentumSettled ? "" : "  FAST"),
         text_color=math.abs(zScore) >= entryZ ? color.new(color.red, 0) : color.new(color.purple, 0))
    table.cell(tbl, 0, 3, "fair NQ", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 3, str.tostring(yhat, "#.##"), text_color=color.new(color.aqua, 0))
    table.cell(tbl, 0, 4, "regime", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 4, (isCalm ? "Calm " : "Volatile ") + "hmm " + str.tostring(pVolHMM * 100, "#") + "% / ewma " + str.tostring(pVolEwma * 100, "#") + "%" + (regimeDefined ? "" : regimeAgree ? " (neutral)" : " (DISAGREE)"),
         text_color=not regimeDefined ? color.new(color.gray, 0) : isCalm ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(tbl, 0, 5, "state", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 5, stateName,
         text_color=state == 3 ? color.new(color.green, 0) : state == 5 ? color.new(color.fuchsia, 0) : txtCol)
    table.cell(tbl, 0, 6, "direction", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 6, dirName,
         text_color=dir == 1 ? color.new(color.green, 0) : dir == -1 ? color.new(color.red, 0) : txtCol)
    table.cell(tbl, 0, 7, "size @ $" + str.tostring(maxRiskUSD, "#"), text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 7, sizeTxt + " (risk $" + str.tostring(riskUsed, "#") + ")", text_color=txtCol)
    table.cell(tbl, 0, 8, "stop / target", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 8, na(stopLinePx) ? str.tostring(stopPts, "#.#") + " pts / " + tpMode : str.tostring(stopLinePx, "#.##") + " / " + str.tostring(tgtLinePx, "#.##") + " (" + tpMode + ")", text_color=txtCol)
    table.cell(tbl, 0, 9, "R (live)", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 9, na(rNow) ? "-" : str.tostring(rNow, "#.##") + (state == 5 ? (canFlip ? "  flip->gap" : "  flatten") : ""),
         text_color=na(rNow) ? txtCol : rNow >= 0 ? color.new(color.green, 0) : color.new(color.red, 0))
    table.cell(tbl, 0, 10, "gap bias", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 10, gapDir == "none" ? "none" : gapDir + " @ " + str.tostring(gapLevel, "#.##") + " (" + gapPolicy + ")",
         text_color=gapDir == "up" ? color.new(color.green, 0) : gapDir == "down" ? color.new(color.red, 0) : txtCol)
    table.cell(tbl, 0, 11, "data", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 11, "chart feed (delayed ~10m without RT sub)", text_color=color.new(color.gray, 20))
    // --- diagnostics: why a setup you expected did not fire ---
    table.cell(tbl, 0, 12, "why no entry", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 12, blockReason,
         text_color=blockReason == "ready" ? color.new(color.green, 0) : color.new(color.yellow, 0))
    table.cell(tbl, 0, 13, "zHold (frozen)", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 13, state >= 2 and not na(frozenSd) ? str.tostring((nq - (frozenA + frozenB * es)) / frozenSd, "#.##") : "-",
         text_color=color.new(color.aqua, 0))
    table.cell(tbl, 0, 14, "beta (log / px)", text_color=txtCol, text_halign=text.align_left)
    table.cell(tbl, 1, 14, str.tostring(bLog, "#.####") + " / " + str.tostring(betaSize, "#.###") + (state >= 3 ? " (entry)" : ""),
         text_color=color.new(color.teal, 0))
    table.cell(tbl, 0, 15, "gates", text_color=color.new(color.gray, 30), text_halign=text.align_left)
    table.cell(tbl, 1, 15, str.tostring(gateMask), text_color=color.new(color.gray, 30))

// ── Parity export ───────────────────────────────────────────────────────
// tests/parityCheck.m consumes these. TradingView's "Export chart data"
// writes every plot() as a column, and display.data_window keeps them out
// of the pane. Everything categorical is an int: the encoding lives in
// src/parityCodes.m and MUST be kept in sync with it.
//   signal: 0 none 1 armed 2 pending 3 enter 4 exit 5 stop 6 reversal
//           7 gap_blocked
G_PX = "Parity export"
pxOn = input.bool(false, "Emit parity export columns", group=G_PX, tooltip="Turn on, then File > Export chart data. Off by default: 15 extra columns clutter the data window.")
pxSignal = sigArm ? 1 : sigPending ? 2 : (sigEnterLong or sigEnterShort) ? 3 : sigExit ? 4 : sigStop ? 5 : sigReversal ? 6 : sigGapBlocked ? 7 : 0
plot(pxOn ? nq        : na, "px_nq",       display=display.data_window)
plot(pxOn ? es        : na, "px_es",       display=display.data_window)
plot(pxOn ? e         : na, "px_e",        display=display.data_window)
plot(pxOn ? resSd     : na, "px_resSd",    display=display.data_window)
plot(pxOn ? resMu     : na, "px_resMu",    display=display.data_window)
plot(pxOn ? zScore    : na, "px_z",        display=display.data_window)
plot(pxOn ? aLog      : na, "px_alphaLog", display=display.data_window)
plot(pxOn ? bLog      : na, "px_betaLog",  display=display.data_window)
plot(pxOn ? b         : na, "px_betaPx",   display=display.data_window)
plot(pxOn ? pVolHMM   : na, "px_pVolHMM",  display=display.data_window)
plot(pxOn ? pVolEwma  : na, "px_pVolEwma", display=display.data_window)
plot(pxOn ? state     : na, "px_state",    display=display.data_window)
plot(pxOn ? dir       : na, "px_dir",      display=display.data_window)
plot(pxOn ? pxSignal  : na, "px_signal",   display=display.data_window)
plot(pxOn ? gateMask  : na, "px_gates",    display=display.data_window)
plot(pxOn ? nNQ       : na, "px_nNQ",      display=display.data_window)
plot(pxOn ? nES       : na, "px_nES",      display=display.data_window)

// ── Alerts ──────────────────────────────────────────────────────────────
// v3 used eight alertcondition() calls. Their message is a compile-time
// constant, so they could only ever say "check the size table" - the eight
// of them together carried less than one actionable line. alert() fires
// from code and CAN embed str.tostring() values, so there is now a single
// alert carrying direction, contract counts, stop, target, R and the
// blocking gate. Set it up once as "Any alert() function call".
// One alertcondition() is kept purely so the script still appears in the
// alert dialog's condition list as a breadcrumb to that setup.
alertOnArm        = input.bool(false, "Alert: convergence armed",   group=G_ALERT)
alertOnPending    = input.bool(false, "Alert: signal pending",      group=G_ALERT)
alertOnEntry      = input.bool(true,  "Alert: entry",               group=G_ALERT)
alertOnExit       = input.bool(true,  "Alert: exit",                group=G_ALERT)
alertOnStop       = input.bool(true,  "Alert: stop",                group=G_ALERT)
alertOnReversal   = input.bool(true,  "Alert: reversal eligible",   group=G_ALERT)
alertOnGapBlocked = input.bool(false, "Alert: entry blocked by gap", group=G_ALERT)

evt = sigEnterLong ? "enter_long" : sigEnterShort ? "enter_short" : sigStop ? "stop" : sigExit ? "exit" : sigReversal ? "reversal" : sigGapBlocked ? "gap_blocked" : sigPending ? "pending" : sigArm ? "armed" : ""

evtEnabled = (sigEnterLong or sigEnterShort) ? alertOnEntry : sigStop ? alertOnStop : sigExit ? alertOnExit : sigReversal ? alertOnReversal : sigGapBlocked ? alertOnGapBlocked : sigPending ? alertOnPending : sigArm ? alertOnArm : false

if evt != "" and evtEnabled
    dirTxt = dir == 1 ? "long_nq_short_es" : dir == -1 ? "short_nq_long_es" : "flat"
    msg = '{"v":4,"evt":"' + evt + '","dir":"' + dirTxt +
      '","time":"' + str.format_time(time, "yyyy-MM-dd HH:mm", syminfo.timezone) + '"' +
      ',"nq":' + str.tostring(nq, "#.##") + ',"es":' + str.tostring(es, "#.##") +
      ',"size":{"nq":' + str.tostring(useMicros ? nMNQ : nNQ) +
              ',"es":' + str.tostring(useMicros ? nMES : nES) +
              ',"micro":' + (useMicros ? "true" : "false") + '}' +
      ',"beta":'    + str.tostring(betaSize, "#.###") +
      ',"stopPts":' + str.tostring(nz(entryStopPts, stopPts), "#.##") +
      ',"stopNQ":'  + str.tostring(stopLinePx, "#.##") +
      ',"tgtNQ":'   + str.tostring(tgtLinePx, "#.##") +
      ',"riskUSD":' + str.tostring(riskUsed, "#") +
      ',"z":'       + str.tostring(zScore, "#.##") +
      ',"zHold":'   + str.tostring(entryZv, "#.##") +
      ',"r":'       + str.tostring(rExit, "#.##") +
      ',"tpR":'     + str.tostring(tpR, "#.#") +
      ',"gates":'   + str.tostring(gateMask) +
      ',"why":"'    + blockReason + '"}'
    alert(msg, alert.freq_once_per_bar_close)

alertcondition(sigEnterLong or sigEnterShort, "Any entry (breadcrumb)",
     "Entry fired. For the full payload (direction, size, stop, target, R) create an 'Any alert() function call' alert on this script instead of this one.")
